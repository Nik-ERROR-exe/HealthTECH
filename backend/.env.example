# ─────────────────────────────────────────────────────────────
# CARENETRA backend — environment template
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` (it holds secrets). This file is
# names-only and safe to track.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL, e.g. Neon) ─────────────────────────
DATABASE_URL=

# ── Auth / JWT ───────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── NVIDIA NIM (free tier — text LLM + embeddings) ───────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
EMBEDDING_MODEL=nvidia/nv-embed-v1
EMBEDDING_DIM=4096
EMBEDDING_BATCH=16

# ── Hugging Face (free inference API — wound image analysis) ─
HUGGINGFACE_API_KEY=

# ── Qdrant (local mode — free, no server) ────────────────────
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=carenetra_knowledge
KNOWLEDGE_DIR=knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5

# ── Alerts (Brevo email / Twilio SMS) ────────────────────────
BREVO_API_KEY=
SENDER_EMAIL=alerts@carenetra.ai
SENDER_NAME=CARENETRA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Frontend / misc ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
DEBUG=true
GOOGLE_MAPS_API_KEY=
